{
    "name": "aurea/framework",
    "description": "Aurea Framework — framework PHP baseado em Componentes e orientado a Eventos",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-xml": "*",
        "ext-zlib": "*",
        "mpdf/mpdf": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpdocumentor/shim": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Aurea\\": "lib/Aurea/",
            "App\\": "app/"
        },
        "classmap": ["lib/", "app/"],
        "files": ["lib/Aurea/Core/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        { "name": "Aurea Framework" }
    ],
    "bin": ["bin/aurea"],
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    }
}
